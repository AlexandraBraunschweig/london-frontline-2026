.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Pipeline working data and outputs — everything here is reproducible from a run.
# Anchored to the repository root: an unanchored `data/` would also match
# viz/public/data, which is committed.
/data/
*.duckdb
*.duckdb.wal

# HTTP caches and logs written by osmnx/osmnet next to the working directory.
cache/
logs/

# Dagster run storage. `dagster asset materialize` creates a throwaway home
# per invocation when DAGSTER_HOME is unset.
.dagster/
.tmp_dagster_home_*/
tmp*/

# macOS Finder droppings. Currently caught only by .git/info/exclude, which
# lives in one clone and is never pushed — a fresh clone would commit these.
.DS_Store
._*

# Editor state and merge leftovers.
*.swp
*.swo
*~
*.orig
*.rej
.idea/
.vscode/

# Machine-local Claude Code permissions. The commands and skills beside it are
# shared on purpose; this file is not.
.claude/settings.local.json

# Packaging output. The hatchling editable install leaves nothing behind, but
# `python -m build` and any setuptools fallback do.
build/
dist/
*.egg-info/

# Test and lint caches.
.coverage
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# Credentials. Nothing in this pipeline needs a key today — every source is
# open — which is exactly the situation in which one gets committed by accident.
.env
.env.*
!.env.example

# Jupyter, for poking at the warehouse interactively.
.ipynb_checkpoints/

# Vite viewer. viz/public/data is deliberately NOT ignored: it is the trimmed
# bundle the hosted site serves, and GitHub Pages builds from the repository.
viz/node_modules/
viz/dist/

# Slide deck. deck/vendor/ IS committed — it is what lets the deck open from a
# file:// URL with nothing installed. node_modules only appears while upgrading
# reveal.js; see deck/README.md.
deck/node_modules/
deck/package-lock.json
